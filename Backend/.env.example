PORT=5001
DB_NAME=ruou_db
CORS_ORIGIN=http://localhost:3000

# Cloudinary Integration URL (replace with your credentials)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# MongoDB Connection String (Atlas or Local)
# Note: In-memory MongoDB fallback will automatically activate if Atlas is not reachable
DB_mongo=mongodb+srv://user:password@cluster.mongodb.net


# Auth: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Set a real random secret (at least 32 bytes); never commit it.
JWT_SECRET=
