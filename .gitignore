# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
.next/
.next-build/
out/

# NestJS / TypeScript build output
dist/
build/
*.tsbuildinfo

# Sensitive Environment variables (protect secrets on public repo)
.env
.env.local
.env.*.local
*.env

# Keep example env files
!.env.example
!Backend/.env.example
!Frontend/.env.example

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary logs
logs/
*.log

# Runtime state data
Backend/src/data/*.json
!Backend/src/data/.gitkeep
Backend/data/

# Text notes & sensitive order files
*.txt
